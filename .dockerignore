# Keep docker build context small. Without this, buildx transfers ~1GB
# (web/node_modules, .git, local artifacts) on every push-*-dev build.

.git
.gitattributes
.github
.cursor
.claude
.vscode
.idea

# Dependencies / build outputs not needed in most images
**/node_modules
web/node_modules
# web/dist IS required: go:embed in web/embed.go for the astonish binary
docs/website/node_modules
docs/website/build
docs/website/.docusaurus

# Local binaries and test artifacts.
# Keep astonish-linux-* and astonish-sandbox-entrypoint in context:
# docker/incus, docker/astonish, docker/sandbox-base, and
# docker/sandbox-openshell COPY the host-built artifacts.
astonish
astonish_bin
test_bin
e2e-inspector
bin/
*.test
*.out
coverage.html
recordings/
.buildx-cache

# Env / secrets / local state
#
# NOTE: a bare `.env` pattern matches ONLY the context root. It does NOT match
# deploy/.env, which holds the real TROUPE_MASTER_KEY / TROUPE_JWT_SECRET.
# Verified with a build-context probe: root .env was excluded, sub/.env was not.
# The `**/` variants close that gap.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
.mcp.json

# Local deployment state — must never enter the build context: the Postgres data
# directory, the app config dir (holds .store_key and credentials.enc), and TLS
# keys. Without this the context grows by hundreds of MB after first boot.
deploy/state
deploy/nginx/certs

# Logs and caches
*.log
*.tmp
**/.cache
**/__pycache__
**/*.pyc

# E2E / scenario runtime state
tests/scenarios/.last-run.json
