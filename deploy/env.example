# Deploy-time environment for `docker compose -f deploy/compose.yaml`.
#
#   cp env.example .env
#
# NOTE: Troupe reads very few environment variables directly. Most runtime
# settings live in config.yaml (deploy/config.example.yaml). Full list of
# TROUPE_* variables actually consumed by the binary:
#   TROUPE_MASTER_KEY   credentials encryption key (64 hex chars)
#   TROUPE_JWT_SECRET   JWT signing key; without it every restart logs you out
#   TROUPE_PLATFORM_DSN PostgreSQL DSN fallback (app_config.go:702-707)
#   TROUPE_DATA_DIR     SQLite data dir fallback (app_config.go:634-646)
#   TROUPE_MODE         default | api | worker (app_config.go:1348-1356)
#   TROUPE_LOG_DEST     file | stdout (pkg/daemon/logger.go:89-103)
#
# There is deliberately NO TROUPE_HOST / TROUPE_PORT here: the HTTP listener is
# hardcoded to ":<port>" (pkg/launcher/studio.go:310). The legacy root
# docker-compose.yml set TROUPE_HOST=0.0.0.0, which the code never reads.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
IMAGE_NAME=troupe-local
IMAGE_VERSION=latest

# ---------------------------------------------------------------------------
# Base images — override ONLY if Docker Hub is unreachable from your network
# ---------------------------------------------------------------------------
# All defaults below point at Docker Hub (registry-1.docker.io). On networks
# where Docker Hub is blocked, prefix each with a reachable mirror, e.g.
#   docker.m.daocloud.io/library/golang:1.27-bookworm
#   docker.m.daocloud.io/library/node:22-bookworm-slim
#   docker.m.daocloud.io/library/debian:bookworm-slim
#   docker.m.daocloud.io/library/nginx:1.27-alpine
#   docker.m.daocloud.io/pgvector/pgvector:pg17
# The uv stage is pulled from ghcr.io, which is usually reachable separately.
#GO_IMAGE=golang:1.27-bookworm
#NODE_IMAGE=node:22-bookworm-slim
#DEBIAN_BASE=debian:bookworm-slim
#NGINX_IMAGE=nginx:1.27-alpine
#POSTGRES_IMAGE=pgvector/pgvector:pg17

# ---------------------------------------------------------------------------
# Debian apt mirror — a SEPARATE problem from the Docker registry mirror
# ---------------------------------------------------------------------------
# A registry mirror (Docker Desktop's registry-mirrors) only covers image pulls.
# It does NOT cover `apt-get`, which the runtime stage runs against
# deb.debian.org directly. Set this when that host is unreachable, otherwise the
# build dies with "E: Failed to fetch http://deb.debian.org/… Connection failed".
#
# MUST be http:// and not https://: ca-certificates is installed by the very same
# step, so the image has no trust store yet and every TLS fetch fails.
#APT_MIRROR=http://mirrors.aliyun.com

# ---------------------------------------------------------------------------
# npm registry — a THIRD, independent channel
# ---------------------------------------------------------------------------
# Both build stages run `npm ci` against registry.npmjs.org. On a slow or
# unstable link that can fail mid-install with:
#   npm error code ECONNRESET
#   npm error network Client network socket disconnected before secure TLS
#   connection was established
# Set a China mirror to make the build deterministic:
#NPM_REGISTRY=https://registry.npmmirror.com

# ---------------------------------------------------------------------------
# Secrets — REQUIRED. Generate before first start:
#   openssl rand -hex 32     # -> TROUPE_MASTER_KEY
#   openssl rand -hex 32     # -> TROUPE_JWT_SECRET
# ---------------------------------------------------------------------------

# 64 hex chars (= 32 bytes). Anything else is rejected with a warning and
# platform secret encryption silently degrades to plaintext
# (pkg/credentials/crypto.go:118-124, entstore/platform_settings.go:287-311).
TROUPE_MASTER_KEY=

# Without this, a random JWT key is generated per start and all sessions are
# invalidated on restart (pkg/daemon/run.go:317-320).
TROUPE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------

# default = HTTP + scheduler + channels + fleet monitors.
# api     = HTTP only (no scheduler/channels/fleet).
# worker  = scheduler + channels + fleet, HTTP not externally meaningful.
TROUPE_MODE=default

# Keep stdout even in `default` mode so `docker compose logs` works.
# In `default` mode without this, logs go to <configDir>/logs/daemon.log.
TROUPE_LOG_DEST=stdout

# ---------------------------------------------------------------------------
# Nginx
# ---------------------------------------------------------------------------
NGINX_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL (default backend — no profile flag needed)
# ---------------------------------------------------------------------------
POSTGRES_USER=troupe
POSTGRES_PASSWORD=troupe

# IMPORTANT: leave this as "postgres". It is the maintenance DB the image
# creates, NOT the platform database. If you pre-create the platform database
# here, bootstrap never runs and only 10 of 24 tables get created (silently
# missing users/organizations/platform_settings/platform_secrets).
POSTGRES_MAINTENANCE_DB=postgres

# Platform DSN. The database name must match config.yaml's
# storage.postgres.instance_suffix via config.PlatformDBName:
#   suffix="local" -> troupe_local_platform
# The daemon auto-creates this database on first start.
TROUPE_PLATFORM_DSN=postgres://troupe:troupe@postgres:5432/troupe_local_platform?sslmode=disable

# ---------------------------------------------------------------------------
# Sandbox (Docker backend, enabled by default)
# ---------------------------------------------------------------------------
# Build the image once on the host before first use:
#   make sandbox-entrypoint build-linux-arm64 docker-sandbox-base
# Without it, sandbox sessions fail to start (chat itself still works).
TROUPE_SANDBOX_IMAGE=ghcr.io/sap/troupe-sandbox-base:dev
